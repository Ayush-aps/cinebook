# Database Credentials (Used by MySQL container and services)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=cinebook_db
MYSQL_USER=cinebook_user
MYSQL_PASSWORD=your_secure_db_password

# Local Database Connection (If running services outside of Docker)
DB_HOST=localhost
DB_PORT=3306
DB_READ_HOST=localhost
DB_READ_PORT=3308

# Service Ports (Internal/External mapping handled in docker-compose)
AUTH_PORT=3001
BOOKING_PORT=3002

# Security
JWT_SECRET=your_super_secret_jwt_key_here
